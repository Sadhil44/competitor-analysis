# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (used by both docker-compose and the backend's DATABASE_URL) ---
POSTGRES_USER=competitor_analysis
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=competitor_analysis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://competitor_analysis:change-me-locally@postgres:5432/competitor_analysis

# --- LLM providers ---
# Used by the agent orchestrator/subagents and by the LLM structured-extraction step.
ANTHROPIC_API_KEY=
# Used to embed Development rows for pgvector semantic search.
VOYAGE_API_KEY=

# --- App config ---
COMPETITORS_CONFIG_PATH=/config/competitors.yaml
OWN_BRANDS_CONFIG_PATH=/config/own_brands.yaml
ENVIRONMENT=development
# Comma-separated extra CORS origins for the backend to accept, beyond the
# hardcoded localhost variants — set this to the deployed frontend's real
# origin in production (e.g. https://your-app.vercel.app). Leave blank for
# local dev.
FRONTEND_ORIGINS=
