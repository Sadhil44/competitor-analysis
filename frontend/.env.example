# Copy to .env.local for standalone (non-Docker) frontend dev, or set these
# as project environment variables on Vercel. Local docker-compose sets
# these itself (see ../docker-compose.yml) — this file isn't read there.

# Server Components (most pages) fetch the backend directly from wherever
# the frontend process runs — in production, the deployed backend's public
# URL (e.g. https://your-backend.up.railway.app).
INTERNAL_API_URL=

# The one client-side fetch (the ask-agent chat) runs in the browser, so it
# needs the backend's public URL too, not an internal one — same value as
# INTERNAL_API_URL in production.
NEXT_PUBLIC_API_URL=
